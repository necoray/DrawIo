        <mxCell id="glccPwyOLuASxe-zW6xg-17" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;pre style=&quot;font-family: &amp;quot;Cascadia Mono&amp;quot;; font-size: 9pt; color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: rgb(111, 0, 138);&quot;&gt;Matrix&lt;/span&gt; mult_matrix_parallel_for(&lt;span style=&quot;color: rgb(111, 0, 138);&quot;&gt;Matrix&lt;/span&gt; &lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;m1&lt;/span&gt;, &lt;span style=&quot;color: rgb(111, 0, 138);&quot;&gt;Matrix&lt;/span&gt; &lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;m2&lt;/span&gt;, &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;int&lt;/span&gt; &lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;size&lt;/span&gt;, &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;double&lt;/span&gt;&amp;amp; &lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;elapsed_time&lt;/span&gt;) {&lt;br&gt;    &lt;span style=&quot;color: rgb(111, 0, 138);&quot;&gt;Matrix&lt;/span&gt; result = allocate_matrix(&lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;size&lt;/span&gt;);&lt;br&gt;    &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;double&lt;/span&gt; t0 = omp_get_wtime();&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;#pragma&lt;/span&gt; omp parallel &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;for&lt;/span&gt; num_threads(&lt;span style=&quot;color: rgb(111, 0, 138);&quot;&gt;NUM_THREADS&lt;/span&gt;)&lt;br&gt;    &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;for&lt;/span&gt; (&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;int&lt;/span&gt; i = 0; i &amp;lt; &lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;size&lt;/span&gt;; ++i) {&lt;br&gt;&lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;#if&lt;/span&gt; &lt;span style=&quot;color: rgb(111, 0, 138);&quot;&gt;__DEBUG__&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;#pragma&lt;/span&gt; omp critical&lt;br&gt;        { std::cout &amp;lt;&amp;lt; &lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot;[FOR] Thread &quot;&lt;/span&gt; &amp;lt;&amp;lt; omp_get_thread_num() &amp;lt;&amp;lt; &lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot; row &quot;&lt;/span&gt; &amp;lt;&amp;lt; i &amp;lt;&amp;lt; &lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&quot;\n&quot;&lt;/span&gt;; }&lt;br&gt;&lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;#endif&lt;/span&gt;&lt;br&gt;        multiply_rows(&lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;m1&lt;/span&gt;, &lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;m2&lt;/span&gt;, result, &lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;size&lt;/span&gt;, i, i + 1);&lt;br&gt;    }&lt;br&gt;&lt;br&gt;    &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;double&lt;/span&gt; t1 = omp_get_wtime();&lt;br&gt;    &lt;span style=&quot;color: rgb(128, 128, 128);&quot;&gt;elapsed_time&lt;/span&gt; = t1 - t0;&lt;br&gt;    &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;return&lt;/span&gt; result;&lt;br&gt;}&lt;br&gt;&lt;br&gt;&lt;/pre&gt;" vertex="1">
