        <mxCell id="glccPwyOLuASxe-zW6xg-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;pre style=&quot;font-family:&#39;Cascadia Mono&#39;;font-size:9pt;color:#000000&quot;&gt;&lt;span style=&quot;color:#008000&quot;&gt;// Эталон: последовательное умножение&lt;/span&gt;&#xa;&lt;span style=&quot;color:#6f008a&quot;&gt;Matrix&lt;/span&gt; mult_matrix_serial(&lt;span style=&quot;color:#6f008a&quot;&gt;Matrix&lt;/span&gt; &lt;span style=&quot;color:#808080&quot;&gt;m1&lt;/span&gt;, &lt;span style=&quot;color:#6f008a&quot;&gt;Matrix&lt;/span&gt; &lt;span style=&quot;color:#808080&quot;&gt;m2&lt;/span&gt;, &lt;span style=&quot;color:#0000ff&quot;&gt;int&lt;/span&gt; &lt;span style=&quot;color:#808080&quot;&gt;size&lt;/span&gt;, &lt;span style=&quot;color:#0000ff&quot;&gt;double&lt;/span&gt;&amp;amp; &lt;span style=&quot;color:#808080&quot;&gt;elapsed_time&lt;/span&gt;) {&#xa;    &lt;span style=&quot;color:#6f008a&quot;&gt;Matrix&lt;/span&gt; result = allocate_matrix(&lt;span style=&quot;color:#808080&quot;&gt;size&lt;/span&gt;);&#xa;    &lt;span style=&quot;color:#0000ff&quot;&gt;double&lt;/span&gt; t0 = omp_get_wtime();&#xa;    multiply_rows(&lt;span style=&quot;color:#808080&quot;&gt;m1&lt;/span&gt;, &lt;span style=&quot;color:#808080&quot;&gt;m2&lt;/span&gt;, result, &lt;span style=&quot;color:#808080&quot;&gt;size&lt;/span&gt;, 0, &lt;span style=&quot;color:#808080&quot;&gt;size&lt;/span&gt;);&#xa;    &lt;span style=&quot;color:#0000ff&quot;&gt;double&lt;/span&gt; t1 = omp_get_wtime();&#xa;    &lt;span style=&quot;color:#808080&quot;&gt;elapsed_time&lt;/span&gt; = t1 - t0;&#xa;    &lt;span style=&quot;color:#0000ff&quot;&gt;return&lt;/span&gt; result;&#xa;}&#xa;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="180" width="560" x="-770" y="-110" as="geometry" />
        </mxCell>
        <mxCell id="glccPwyOLuASxe-zW6xg-6" edge="1" parent="1" source="glccPwyOLuASxe-zW6xg-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="glccPwyOLuASxe-zW6xg-5">
