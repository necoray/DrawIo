        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam roundcorner 10\n\nactor \&quot;Игрок\&quot; as Player\n\npackage \&quot;Игрок\&quot; {\n  usecase \&quot;Проверять статус своей регистрации на мероприятие\&quot; as UC_CheckRegStatus\n  usecase \&quot;Просматривать интерактивную карту мероприятия (видит только себя, ФТ12)\&quot; as UC_ViewEventMapSelf\n  usecase \&quot;Отменить  заявку на мероприятие (ФТ6.2)\&quot; as UC_CancelEvent\n}\n\nPlayer --&gt; UC_CheckRegStatus\nPlayer --&gt; UC_ViewEventMapSelf\nPlayer --&gt; UC_CancelEvent\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="8muY6lDNwMUpHzWzClxa-81">
