  <diagram name="Страница-1" id="FITUtxbGJsi0tUoUJ7qs">
    <mxGraphModel dx="3002" dy="1218" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam ArrowColor #333333\n\nactor \&quot;Неавторизированный пользователь\&quot; as Guest\nactor \&quot;Авторизованный пользователь\&quot; as AuthUser\nactor \&quot;Игрок\&quot; as Player\nactor \&quot;Участник команды\&quot; as TeamMember\nactor \&quot;Командир команды\&quot; as Commander\nactor \&quot;Организатор\&quot; as Organizer\n\nAuthUser -&gt; Guest\nPlayer -|&gt; AuthUser\nTeamMember -|&gt; Player\nCommander -|&gt; TeamMember\nOrganizer -|&gt; AuthUser\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="8muY6lDNwMUpHzWzClxa-76">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="637" width="276" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam roundcorner 10\n\nactor \&quot;Неавторизованный пользователь\&quot; as Guest\n\npackage \&quot;Неавторизованный пользователь\&quot; {\n  usecase \&quot;Авторизоваться в системе\&quot; as UC_Login\n  usecase \&quot;Зарегистрировать аккаунт\&quot; as UC_Register\n  usecase \&quot;Искать и фильтровать мероприятия\&quot; as UC_SearchEvents\n  usecase \&quot;Просмотреть детальную страницу мероприятия\&quot; as UC_ViewEvent\n  usecase \&quot;Искать и просматривать публичные профили команд\&quot; as UC_ViewTeams\n}\n\nGuest --&gt; UC_Login\nGuest --&gt; UC_Register\nGuest --&gt; UC_SearchEvents\nGuest --&gt; UC_ViewEvent\nGuest --&gt; UC_ViewTeams\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="8muY6lDNwMUpHzWzClxa-77">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="482" width="635" x="55" y="770" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam roundcorner 10\n\nactor \&quot;Авторизованный пользователь\&quot; as AuthUser\n\npackage \&quot;Авторизованный пользователь\&quot; {\n  usecase \&quot;Создать новую команду\&quot; as UC_CreateTeam\n  usecase \&quot;Регистрация на мероприятие как одиночный игрок\&quot; as UC_RegEventSolo\n  usecase \&quot;Просмотреть фильтр &#39;Мои мероприятия&#39;\&quot; as UC_MyEvents\n  usecase \&quot;Отправить заявку на вступление в команду\&quot; as UC_JoinTeam\n  usecase \&quot;Просмотреть интерактивную карту полигона (базовый просмотр, без сущностей)\&quot; as UC_ViewMap\n}\n\nAuthUser --&gt; UC_CreateTeam\nAuthUser --&gt; UC_RegEventSolo\nAuthUser --&gt; UC_MyEvents\nAuthUser --&gt; UC_JoinTeam\nAuthUser --&gt; UC_ViewMap\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="8muY6lDNwMUpHzWzClxa-78">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="549" width="807" x="70" y="1440" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam roundcorner 10\n\nactor \&quot;Командир команды\&quot; as Commander\n\npackage \&quot;Командир команды\&quot; {\n  usecase \&quot;Зарегистрировать команду на мероприятие\&quot; as UC_RegTeamEvent\n  usecase \&quot;Редактировать профиль своей команды (логотип, описание)\&quot; as UC_EditTeam\n  usecase \&quot;Просматривать интерактивную карту мероприятия (видит всю свою команду)\&quot; as UC_ViewEventMapTeam\n  usecase \&quot;Управлять заявками на вступление (одобрение/отклонение)\&quot; as UC_ManageRequests\n  usecase \&quot;Управлять составом команды (исключение участников)\&quot; as UC_ManageRoster\n  usecase \&quot;Фильтровать списки участников и заявок (по имени/позывному)\&quot; as UC_FilterTeam\n}\n\nCommander --&gt; UC_RegTeamEvent\nCommander --&gt; UC_EditTeam\nCommander --&gt; UC_ViewEventMapTeam\nCommander --&gt; UC_ManageRequests\nCommander --&gt; UC_ManageRoster\nCommander --&gt; UC_FilterTeam\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="8muY6lDNwMUpHzWzClxa-79">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="743" width="703" x="1450" y="1306" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam roundcorner 10\n\nactor \&quot;Участник команды\&quot; as TeamMember\n\npackage \&quot;Участник команды\&quot; {\n  usecase \&quot;Участвовать на мероприятиях в составе команды\&quot; as UC_TeamEventParticipation\n  usecase \&quot;Выйти из состава команды\&quot; as UC_LeaveTeam\n  usecase \&quot;Просматривать состав своей команды (только чтение)\&quot; as UC_ViewRoster\n}\n\nTeamMember --&gt; UC_TeamEventParticipation\nTeamMember --&gt; UC_LeaveTeam\nTeamMember --&gt; UC_ViewRoster\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="8muY6lDNwMUpHzWzClxa-80">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="325" width="565" x="1450" y="799.5" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam roundcorner 10\n\nactor \&quot;Игрок\&quot; as Player\n\npackage \&quot;Игрок\&quot; {\n  usecase \&quot;Проверять статус своей регистрации на мероприятие\&quot; as UC_CheckRegStatus\n  usecase \&quot;Просматривать интерактивную карту мероприятия (видит только себя)\&quot; as UC_ViewEventMapSelf\n  usecase \&quot;Отменить  заявку на мероприятие \&quot; as UC_CancelEvent\n}\n\nPlayer --&gt; UC_CheckRegStatus\nPlayer --&gt; UC_ViewEventMapSelf\nPlayer --&gt; UC_CancelEvent\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="8muY6lDNwMUpHzWzClxa-81">
