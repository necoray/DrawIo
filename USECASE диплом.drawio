          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam roundcorner 10\n\nactor \&quot;Неавторизованный пользователь\&quot; as Guest\n\npackage \&quot;Неавторизованный пользователь\&quot; {\n  usecase \&quot;Авторизоваться в системе (ФТ1)\&quot; as UC_Login\n  usecase \&quot;Зарегистрировать аккаунт (ФТ2)\&quot; as UC_Register\n  usecase \&quot;Искать и фильтровать мероприятия (ФТ7)\&quot; as UC_SearchEvents\n  usecase \&quot;Просмотреть детальную страницу мероприятия (ФТ6.1)\&quot; as UC_ViewEvent\n  usecase \&quot;Искать и просматривать публичные профили команд (ФТ8, ФТ10)\&quot; as UC_ViewTeams\n}\n\nGuest --&gt; UC_Login\nGuest --&gt; UC_Register\nGuest --&gt; UC_SearchEvents\nGuest --&gt; UC_ViewEvent\nGuest --&gt; UC_ViewTeams\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="8muY6lDNwMUpHzWzClxa-77">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="536" width="720.69" x="55" y="770" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam roundcorner 10\n\nactor \&quot;Авторизованный пользователь\&quot; as AuthUser\n\npackage \&quot;Авторизованный пользователь\&quot; {\n  usecase \&quot;Создать новую команду (ФТ9)\&quot; as UC_CreateTeam\n  usecase \&quot;Регистрация на мероприятие как одиночный игрок (ФТ3)\&quot; as UC_RegEventSolo\n  usecase \&quot;Просмотреть фильтр &#39;Мои мероприятия&#39; (ФТ7.3)\&quot; as UC_MyEvents\n  usecase \&quot;Отправить заявку на вступление в команду (ФТ10.1)\&quot; as UC_JoinTeam\n  usecase \&quot;Просмотреть интерактивную карту полигона (базовый просмотр, без сущностей ФТ12.1-12.2)\&quot; as UC_ViewMap\n}\n\nAuthUser --&gt; UC_CreateTeam\nAuthUser --&gt; UC_RegEventSolo\nAuthUser --&gt; UC_MyEvents\nAuthUser --&gt; UC_JoinTeam\nAuthUser --&gt; UC_ViewMap\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="8muY6lDNwMUpHzWzClxa-78">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="604" width="891" x="70" y="1440" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam roundcorner 10\n\nactor \&quot;Командир команды\&quot; as Commander\n\npackage \&quot;Командир команды\&quot; {\n  usecase \&quot;Зарегистрировать команду на мероприятие (ФТ3, ФТ6.2)\&quot; as UC_RegTeamEvent\n  usecase \&quot;Редактировать профиль своей команды (логотип, описание, ФТ10.2)\&quot; as UC_EditTeam\n  usecase \&quot;Просматривать интерактивную карту мероприятия (видит всю свою команду, ФТ12)\&quot; as UC_ViewEventMapTeam\n  usecase \&quot;Управлять заявками на вступление (одобрение/отклонение, ФТ11.3-11.5)\&quot; as UC_ManageRequests\n  usecase \&quot;Управлять составом команды (исключение участников, ФТ11)\&quot; as UC_ManageRoster\n  usecase \&quot;Фильтровать списки участников и заявок (по имени/позывному, ФТ11.4)\&quot; as UC_FilterTeam\n}\n\nCommander --&gt; UC_RegTeamEvent\nCommander --&gt; UC_EditTeam\nCommander --&gt; UC_ViewEventMapTeam\nCommander --&gt; UC_ManageRequests\nCommander --&gt; UC_ManageRoster\nCommander --&gt; UC_FilterTeam\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="8muY6lDNwMUpHzWzClxa-79">
