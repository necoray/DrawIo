        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam roundcorner 10\n\nactor \&quot;Организатор\&quot; as Organizer\n\npackage \&quot;Организатор\&quot; {\n  usecase \&quot;Создать мероприятие (атрибуты, медиа, KMZ, стороны, превью, ФТ5)\&quot; as UC_CreateEvent\n  usecase \&quot;Редактировать мероприятие (изменение сторон, превью, статуса мероприятия, ФТ5)\&quot; as UC_EditEvent\n  usecase \&quot;Выгрузить список участников в CSV (ФТ6.3)\&quot; as UC_ExportCSV\n  usecase \&quot;Отслеживать на карте всех участников и персонал в реальном времени (ФТ12.3-12.6)\&quot; as UC_TrackLive\n  usecase \&quot;Фильтровать и скрывать объекты на карте (сторона, команда, игрок, персонал, ФТ12.7-12.9)\&quot; as UC_FilterMapObjects\n  usecase \&quot;Развернуть карту в полноэкранный режим (ФТ12.10)\&quot; as UC_FullscreenMap\n}\n\nOrganizer --&gt; UC_CreateEvent\nOrganizer --&gt; UC_EditEvent\nOrganizer --&gt; UC_ExportCSV\nOrganizer --&gt; UC_TrackLive\nOrganizer --&gt; UC_FilterMapObjects\nOrganizer --&gt; UC_FullscreenMap\n\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="8muY6lDNwMUpHzWzClxa-106">
