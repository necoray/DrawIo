        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam roundcorner 10\nskinparam ArrowColor #333333\n\nactor \&quot;Неавторизированный пользователь\&quot; as Guest\nactor \&quot;Авторизованный пользователь\&quot; as AuthUser\nactor \&quot;Игрок\&quot; as Player\nactor \&quot;Участник команды\&quot; as TeamMember\nactor \&quot;Командир команды\&quot; as Commander\nactor \&quot;Организатор\&quot; as Organizer\n\nAuthUser -&gt; Guest\nPlayer -|&gt; AuthUser\nTeamMember -|&gt; Player\nCommander -|&gt; TeamMember\nOrganizer -|&gt; AuthUser\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="8muY6lDNwMUpHzWzClxa-76">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
