        <mxCell id="8muY6lDNwMUpHzWzClxa-87" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" value="Неавторизированный пользователь" vertex="1">
